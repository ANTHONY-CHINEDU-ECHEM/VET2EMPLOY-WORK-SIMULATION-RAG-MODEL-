+
+  - repo: local
+    hooks:
+      - id: no-knowledge-base-files
+        name: knowledge base files stay out of git
+        entry: knowledge base files are confidential; distribute them through an approved channel
+        language: fail
+        files: ^knowledge_base/raw/(?!\.gitkeep$)
+      - id: house-style
+        name: house style (no em or en dashes, no hyphens in docs prose)
+        entry: pytest tests/test_repository_style.py -q
