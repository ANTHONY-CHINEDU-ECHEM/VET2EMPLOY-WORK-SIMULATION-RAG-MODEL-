+"""Service level exceptions shared by the API, the CLI and the generation pipeline.
+
+Each exception maps to one public error code in the HTTP contract (see
+``v2e_rag.api.errors``). Keeping them here, free of web framework imports, lets the
+generation and storage layers raise meaningful errors without knowing about HTTP.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+class ServiceError(Exception):
+    """Base class for errors that carry a stable public code."""
+
+    code = "service_error"
+
+    def __init__(self, message: str, details: dict[str, Any] | None = None) -> None:
+        super().__init__(message)
+        self.details = details or {}
+
+
+class ServiceNotConfiguredError(ServiceError):
+    """A dependency the request needs (for example OpenRouter) is not configured."""
+
+    code = "service_unavailable"
+
+
+class StoreUnavailableError(ServiceError):
+    """The knowledge base store could not be reached."""
+
+    code = "store_unavailable"
+
+
+class UnknownChunksError(ServiceError):
+    """A caller referenced knowledge base chunks that do not exist."""
+
+    code = "unknown_chunks"
+
+    def __init__(self, missing: list[str]) -> None:
+        super().__init__(
+            f"{len(missing)} chunk id(s) do not exist in the knowledge base.",
+            {"missing": missing},
+        )
+        self.missing = missing
+
+
+class InvalidRequestError(ServiceError):
+    """A request is well formed but inconsistent with the configured catalogue."""
+
+    code = "invalid_request"
+
+
+class IngestionLockedError(ServiceError):
+    """Another ingestion run holds the knowledge base lock."""
+
+    code = "ingestion_in_progress"
