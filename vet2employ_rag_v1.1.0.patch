+# Ingestion pruning ----------------------------------------------------------------------------
+
+
+def _pipeline(store: MemoryStore) -> IngestionPipeline:
+    catalog = load_catalog(str(ROOT / "config"))
+    return IngestionPipeline(store, CachedEmbedder(HashingEmbedder(64), store), catalog)
+
